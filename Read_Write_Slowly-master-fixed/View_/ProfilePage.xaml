<UserControl x:Class="Read_Write_Slowly.View_.ProfilePage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="#f8f9fa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="20">
            <materialDesign:Card Padding="20" UniformCornerRadius="12" Background="White">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountCircle" Width="100" Height="100" Foreground="#673AB7" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding CurrentUser.DisplayName}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUser.RoleName}" FontSize="14" Foreground="Gray" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,15"/>

                    <Separator Background="#eee" Margin="0,10"/>

                    <StackPanel Margin="0,5">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <materialDesign:PackIcon Kind="Login" Foreground="DimGray" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Логин: " Foreground="Gray"/>
                            <TextBlock Text="{Binding CurrentUser.Login}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <materialDesign:PackIcon Kind="Email" Foreground="DimGray" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Email: " Foreground="Gray"/>
                            <TextBlock Text="{Binding CurrentUser.Email}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <materialDesign:PackIcon Kind="Calendar" Foreground="DimGray" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Регистрация: " Foreground="Gray"/>
                            <TextBlock Text="{Binding CurrentUser.RegistrationDate}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <Button Content="Подать заявку на Автора" 
                    Command="{Binding ApplyForAuthorCommand}"
                    Visibility="{Binding AuthorButtonVisibility}"
                    Margin="0,20,0,0" Height="45"
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#673AB7" BorderBrush="#673AB7"/>

            <materialDesign:Card Visibility="{Binding FrozenWarningVisibility}" 
                                 Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1"
                                 Padding="15" Margin="0,20,0,0" UniformCornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="Red" Width="24" Height="24" VerticalAlignment="Center"/>
                        <TextBlock Text="Ваш аккаунт заморожен!" Foreground="Red" FontSize="16" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Вы не можете оставлять новые отзывы и публиковать контент. Вы можете отправить апелляцию администрации:" 
                               TextWrapping="Wrap" FontSize="13" Foreground="#555" Margin="0,0,0,10"/>

                    <TextBox Text="{Binding UnfreezeReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="70" TextWrapping="Wrap" Background="White"
                             materialDesign:HintAssist.Hint="Опишите причину разблокировки..."/>

                    <Button Content="Отправить апелляцию" Command="{Binding SubmitUnfreezeCommand}" 
                            Margin="0,10,0,0" Background="Red" BorderBrush="Red" HorizontalAlignment="Right" Height="32"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>

        <Grid Grid.Column="1" Margin="10,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Мои отзывы и оценки" FontSize="20" FontWeight="Bold" Margin="10,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListBox ItemsSource="{Binding UserReviews}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="10,0,10,12" Padding="15" Background="White" UniformCornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BookOpenPageVariant" Foreground="#673AB7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BookTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                                            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Star" Foreground="Gold" Width="18" Height="18" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Rating}" FontWeight="Bold" Margin="4,0,0,0" FontSize="14" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14" Foreground="#333"/>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
