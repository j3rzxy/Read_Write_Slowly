<Window x:Class="Read_Write_Slowly.View_.BookReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}"
        Height="700" Width="860"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e2e"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: название + автор + кнопка закрыть -->
        <Border Grid.Row="0" Background="#2a2a3e" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding BookTitle}"
                               Foreground="#e0e0ff" FontSize="18" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AuthorName}"
                               Foreground="#9898b8" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Foreground="#9898b8" ToolTip="Закрыть">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Текст книги -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#1e1e2e"
                      Padding="0,0,4,0">
            <TextBox x:Name="ContentBox"
                     Text="{Binding ContentText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#d4d4e8"
                     FontFamily="Georgia"
                     FontSize="{Binding FontSize}"
                     Padding="60,30,60,40"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Disabled"
                     HorizontalScrollBarVisibility="Disabled"
                     CaretBrush="Transparent"
                     SelectionBrush="#5555aa"
                     IsUndoEnabled="False"/>
        </ScrollViewer>

        <!-- Нижняя панель: управление шрифтом + прогресс прокрутки -->
        <Border Grid.Row="2" Background="#2a2a3e" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Размер шрифта -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Шрифт:" Foreground="#9898b8" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Button Content="A-"
                            Command="{Binding DecreaseFontCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#9898b8" Height="28" MinWidth="32" Padding="4,0"
                            ToolTip="Уменьшить шрифт"/>

                    <TextBlock Text="{Binding FontSize, StringFormat={}{0}px}"
                               Foreground="#e0e0ff" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="4,0" MinWidth="36"
                               TextAlignment="Center"/>

                    <Button Content="A+"
                            Command="{Binding IncreaseFontCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#9898b8" Height="28" MinWidth="32" Padding="4,0"
                            ToolTip="Увеличить шрифт"/>
                </StackPanel>

                <!-- Знаковый счётчик -->
                <TextBlock Grid.Column="2"
                           Text="{Binding CharCount, StringFormat={}Символов: {0}}"
                           Foreground="#9898b8" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
