<UserControl x:Class="Read_Write_Slowly.View_.BookPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <!-- Строка с кнопкой «Назад» -->
            <RowDefinition Height="Auto"/>
            <!-- Основное содержимое -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка с кнопкой назад -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Button Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Left" Margin="10,5">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="Назад к каталогу" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: обложка, описание, кнопки -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <materialDesign:Card UniformCornerRadius="8" Padding="0" Margin="0,0,0,15">
                        <Image Source="{Binding CurrentBook.CoverPath}" Height="450" Stretch="UniformToFill"/>
                    </materialDesign:Card>

                    <TextBlock Text="{Binding CurrentBook.Title}"
                               FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding CurrentBook.AuthorName}"
                               FontSize="16" Foreground="#3498db" Margin="0,0,0,15" FontWeight="SemiBold"/>

                    <Button Content="Читать книгу"
                            Command="{Binding ReadBookCommand}"
                            Height="45" Margin="0,0,0,15"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>

                    <TextBlock Text="Описание:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding CurrentBook.Description}"
                               FontSize="14" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,20"/>

                    <Button Content="Пожаловаться на книгу"
                            Command="{Binding ComplainBookCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red"/>

                    <!-- Панель администратора -->
                    <StackPanel Visibility="{Binding AdminControlsVisibility}" Margin="0,20,0,0">
                        <Separator Background="Red" Margin="0,10"/>
                        <TextBlock Text="Панель администратора"
                                   Foreground="Red" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button Content="Заморозить книгу"
                                Command="{Binding FreezeBookCommand}"
                                Background="DarkRed" BorderBrush="DarkRed" Foreground="White"/>
                    </StackPanel>
                </StackPanel>

                <!-- Правая колонка: форма отзыва + список отзывов -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Форма отзыва -->
                    <materialDesign:Card Grid.Row="0" Padding="15" Margin="0,0,0,20" Background="White">
                        <StackPanel>
                            <TextBlock Text="Оставить отзыв"
                                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Ваша оценка: " VerticalAlignment="Center"/>
                                <ComboBox Width="70" Margin="10,0,0,0"
                                          SelectedValue="{Binding NewReviewRating}">
                                    <system:Double>5</system:Double>
                                    <system:Double>4</system:Double>
                                    <system:Double>3</system:Double>
                                    <system:Double>2</system:Double>
                                    <system:Double>1</system:Double>
                                </ComboBox>
                                <materialDesign:PackIcon Kind="Star" Foreground="Gold"
                                                         Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Text="{Binding NewReviewText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                                     materialDesign:HintAssist.Hint="Напишите, что вы думаете о книге..."/>

                            <Button Content="Отправить отзыв"
                                    Command="{Binding SubmitReviewCommand}"
                                    HorizontalAlignment="Right" Margin="0,10,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Список отзывов -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Reviews}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Margin="0,0,0,10" Padding="15" Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Заголовок отзыва -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding UserDisplayName}"
                                                           FontWeight="Bold" FontSize="14"/>
                                                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                                                    <materialDesign:PackIcon Kind="Star"
                                                                             Foreground="Gold"
                                                                             Width="16" Height="16"/>
                                                    <TextBlock Text="{Binding Rating}"
                                                               FontWeight="Bold" Margin="3,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}"
                                                       Foreground="Gray" FontSize="12"/>
                                        </Grid>

                                        <!-- Текст отзыва -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,10" FontSize="14"/>

                                        <!-- Кнопки действий -->
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Пожаловаться"
                                                    Command="{Binding DataContext.ComplainReviewCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="Orange" Height="30" FontSize="12"/>

                                            <Button Content="Заморозить отзыв"
                                                    Command="{Binding DataContext.FreezeReviewCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.AdminControlsVisibility,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="DarkRed" Height="30" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>