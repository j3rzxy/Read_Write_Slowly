<UserControl x:Class="Read_Write_Slowly.View_.AdminPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="#f5f6fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="20" Background="#3F51B5" UniformCornerRadius="0">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ShieldAccount" Foreground="White" Width="32" Height="32" VerticalAlignment="Center"/>
                <TextBlock Text="Панель Управления Администратора" Foreground="White" FontSize="22" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryLight" Style="{StaticResource MaterialDesignTabControl}">

            <TabItem Header="Заявки на роль Автора">
                <Grid Margin="15">
                    <DataGrid ItemsSource="{Binding RoleApplications}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ Заявки" Binding="{Binding RoleApplicationId}" Width="100"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding UserLogin}" Width="150"/>
                            <DataGridTextColumn Header="Отображаемое имя" Binding="{Binding UserDisplayName}" Width="200"/>
                            <DataGridTextColumn Header="Запрашиваемая роль" Binding="{Binding RequestedRoleName}" Width="180"/>
                            <DataGridTextColumn Header="Дата подачи" Binding="{Binding CreatedAt}" Width="180"/>

                            <DataGridTemplateColumn Header="Действия" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Одобрить" 
                                                    Command="{Binding DataContext.ApproveRoleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#4CAF50" BorderBrush="#4CAF50" Height="28" Margin="0,0,8,0" Padding="10,0"/>
                                            <Button Content="Отклонить" 
                                                    Command="{Binding DataContext.RejectRoleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#F44336" BorderBrush="#F44336" Height="28" Padding="10,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Апелляции на разморозку">
                <Grid Margin="15">
                    <DataGrid ItemsSource="{Binding UnfreezeRequests}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding UnfreezeRequestId}" Width="60"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserDisplayName}" Width="150"/>
                            <DataGridTextColumn Header="Объект разбанa" Binding="{Binding TargetName}" Width="180"/>

                            <DataGridTemplateColumn Header="Причина / Объяснение автора" Width="350">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="5" FontSize="13"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Дата отправки" Binding="{Binding CreatedAt}" Width="150"/>

                            <DataGridTemplateColumn Header="Решение" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Разморозить" 
                                                    Command="{Binding DataContext.ApproveUnfreezeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#009688" BorderBrush="#009688" Height="28" Margin="0,0,8,0" Padding="10,0"/>
                                            <Button Content="Оставить бан" 
                                                    Command="{Binding DataContext.RejectUnfreezeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#607D8B" BorderBrush="#607D8B" Height="28" Padding="10,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Жалобы от пользователей">
                <Grid Margin="15">
                    <DataGrid ItemsSource="{Binding Complaints}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding ComplaintId}" Width="50"/>
                            <DataGridTextColumn Header="От кого" Binding="{Binding ReporterName}" Width="150"/>
                            <DataGridTextColumn Header="Тип объекта" Binding="{Binding TargetType}" Width="100"/>

                            <DataGridTemplateColumn Header="Автор отзыва" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TargetType}" Value="review">
                                                            <Setter Property="Text" Value="{Binding ReviewAuthorName}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Text" Value="—"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Содержание объекта" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TargetDescription}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Суть жалобы" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="DarkRed" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="150"/>

                            <DataGridTemplateColumn Header="Действия" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Принять (Заморозить)" 
                                        Command="{Binding DataContext.ApproveComplaintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="#E53935" BorderBrush="#E53935" Height="28" Margin="0,0,8,0" Padding="10,0"/>
                                            <Button Content="Отклонить" 
                                        Command="{Binding DataContext.RejectComplaintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="Gray" BorderBrush="Gray" Height="28" Padding="10,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Добавить книгу">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="15">
                    <materialDesign:Card Padding="20" Background="White" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Добавление новой книги" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                            <!-- Автор -->
                            <ComboBox ItemsSource="{Binding Authors}"
                                      SelectedItem="{Binding SelectedAuthor}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="Выберите автора"
                                      Margin="0,0,0,15"/>

                            <!-- Название -->
                            <TextBox Text="{Binding AdminBookTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Название книги"
                                     Margin="0,0,0,15" FontSize="15"/>

                            <!-- Обложка -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding AdminBookCoverPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         materialDesign:HintAssist.Hint="Путь к файлу обложки"
                                         IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="📁 Обзор..."
                                        Command="{Binding AdminBrowseCoverCommand}"
                                        Height="36" Margin="8,0,0,0" Padding="12,0"/>
                            </Grid>

                            <!-- Описание -->
                            <TextBox Text="{Binding AdminBookDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                                     materialDesign:HintAssist.Hint="Аннотация / Описание книги"
                                     Margin="0,0,0,15"/>

                            <!-- Текст -->
                            <TextBlock Text="Текст книги / Главы:" FontSize="14" Foreground="Gray" Margin="0,5,0,5"/>
                            <TextBox Text="{Binding AdminBookContent, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" Height="200" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" AcceptsTab="True"
                                     materialDesign:HintAssist.Hint="Текст произведения..."
                                     FontFamily="Consolas" FontSize="13"/>

                            <!-- Жанры -->
                            <Border Margin="0,15,0,0" BorderBrush="#ddd" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="TagMultiple" Width="20" Height="20"
                                                                 Foreground="#3F51B5" VerticalAlignment="Center"/>
                                        <TextBlock Text="Жанры книги" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#3F51B5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Отметьте один или несколько жанров:"
                                               FontSize="12" Foreground="Gray" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding AllGenres}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,3,8,3" CornerRadius="14" Padding="2,0">
                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                              Content="{Binding Name}"
                                                              Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Кнопки -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Content="Очистить форму"
                                        Command="{Binding AdminClearFormCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,12,0" Height="40" Padding="16,0"/>
                                <Button Content="Добавить книгу"
                                        Command="{Binding AdminSaveBookCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="40" Padding="20,0" Background="#3F51B5" BorderBrush="#3F51B5"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
