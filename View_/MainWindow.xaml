<Window x:Class="Read_Write_Slowly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:Read_Write_Slowly.ViewModels_"
        xmlns:views="clr-namespace:Read_Write_Slowly.View_"
        Title="Шут и Кроль — Электронная Библиотека"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <DataTemplate DataType="{x:Type viewmodels:CatalogViewModel}">
            <views:CatalogPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:BookDetailsViewModel}">
            <views:BookPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ProfileViewModel}">
            <views:ProfilePage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:UserListsViewModel}">
            <views:UserListsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:AuthorViewModel}">
            <views:AuthorPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:AdminViewModel}">
            <views:AdminPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== БОКОВОЕ МЕНЮ ===== -->
        <Border Grid.Column="0" Background="#1E1E2D">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Аватар + имя -->
                    <RowDefinition Height="*"/>
                    <!-- Пункты меню -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кнопка выхода -->
                </Grid.RowDefinitions>

                <!-- Блок профиля -->
                <StackPanel Grid.Row="0" Margin="20,30,20,20" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountCircle"
                                             Width="60" Height="60"
                                             Foreground="White"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUser.DisplayName}"
                               Foreground="White" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock Text="{Binding CurrentUser.Email}"
                               Foreground="#A2A3B7" FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentUser.RoleName}"
                               Foreground="#7B7D9D" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <Rectangle Grid.Row="0" VerticalAlignment="Bottom"
                           Height="1" Fill="#2E2E42" Margin="15,0"/>

                <!-- Пункты меню -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="10,10,10,0">
                    <StackPanel>

                        <!-- Каталог книг — доступен всем -->
                        <Button Command="{Binding OpenCatalogCommand}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                Background="Transparent" BorderBrush="Transparent"
                                Foreground="White" Height="48"
                                HorizontalContentAlignment="Left" Margin="0,3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Каталог книг"
                                           Margin="15,0,0,0" VerticalAlignment="Center"
                                           FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <!-- Мои списки — доступен всем авторизованным -->
                        <Button Command="{Binding OpenMyListsCommand}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                Background="Transparent" BorderBrush="Transparent"
                                Foreground="White" Height="48"
                                HorizontalContentAlignment="Left" Margin="0,3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bookshelf"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Мои списки"
                                           Margin="15,0,0,0" VerticalAlignment="Center"
                                           FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <!-- Профиль — доступен всем авторизованным -->
                        <Button Command="{Binding OpenProfileCommand}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                Background="Transparent" BorderBrush="Transparent"
                                Foreground="White" Height="48"
                                HorizontalContentAlignment="Left" Margin="0,3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountEdit"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Мой профиль"
                                           Margin="15,0,0,0" VerticalAlignment="Center"
                                           FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <!-- Разделитель перед разделами ролей -->
                        <Rectangle Height="1" Fill="#2E2E42" Margin="10,8"/>

                        <!-- Панель автора — только для RoleId = 2 или 3 -->
                        <Button Command="{Binding OpenAuthorPanelCommand}"
                                Visibility="{Binding IsAuthorMenuVisible,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                Background="Transparent" BorderBrush="Transparent"
                                Foreground="White" Height="48"
                                HorizontalContentAlignment="Left" Margin="0,3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Моё творчество"
                                           Margin="15,0,0,0" VerticalAlignment="Center"
                                           FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <!-- Администрирование — только для RoleId = 3 -->
                        <Button Command="{Binding OpenAdminPanelCommand}"
                                Visibility="{Binding IsAdminMenuVisible,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                Background="Transparent" BorderBrush="Transparent"
                                Foreground="White" Height="48"
                                HorizontalContentAlignment="Left" Margin="0,3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldCrown"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Администрирование"
                                           Margin="15,0,0,0" VerticalAlignment="Center"
                                           FontSize="14"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Кнопка выхода -->
                <Button Grid.Row="2"
                        Command="{Binding LogoutCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#F44336" Height="50" Margin="10,10,10,15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout"
                                                 Width="22" Height="22"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Выйти из аккаунта"
                                   Margin="15,0,0,0" VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== ОСНОВНАЯ ОБЛАСТЬ — ContentControl подхватывает DataTemplate по типу ViewModel ===== -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
