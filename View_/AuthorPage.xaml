<UserControl x:Class="Read_Write_Slowly.View_.AuthorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Read_Write_Slowly.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImage"/>
        <BooleanToVisibilityConverter    x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#f5f6fa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Мои произведения" FontSize="20" FontWeight="Bold" Margin="5,0,0,15"/>

            <ListBox Grid.Row="1" ItemsSource="{Binding MyBooks}" SelectedItem="{Binding SelectedBook}"
                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0,0,0,10" Padding="12" Background="White">
                            <materialDesign:Card.Style>
                                <Style TargetType="materialDesign:Card" BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFrozen}" Value="1">
                                            <Setter Property="BorderBrush" Value="Red"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:Card.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Source="{Binding CoverPath, Converter={StaticResource PathToImage}}"
       Height="80" Stretch="UniformToFill"/>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="ЗАМОРОЖЕНА АДМИНИСТРАЦИЕЙ" Foreground="Red" FontSize="11" FontWeight="Bold" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFrozen}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="15">
            <StackPanel>

                <materialDesign:Card Visibility="{Binding UnfreezePanelVisibility}" 
                                     Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" 
                                     Padding="15" Margin="0,0,0,15" UniformCornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <materialDesign:PackIcon Kind="AlertDecagram" Foreground="Orange" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Книга заблокирована. Подать запрос на разморозку:" 
                                       Foreground="#E65100" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox Text="{Binding UnfreezeReason, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" Height="60"
                                 materialDesign:HintAssist.Hint="Опишите, почему модератор должен разблокировать книгу..." Background="White"/>
                        <Button Content="Отправить запрос" Command="{Binding SubmitUnfreezeCommand}" 
                                Background="Orange" BorderBrush="Orange" HorizontalAlignment="Right" Margin="0,10,0,0" Height="32"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="20" Background="White" UniformCornerRadius="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="{Binding FormHeader}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="Очистить / Новая книга" Command="{Binding ClearFormCommand}" 
                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Название произведения" Margin="0,0,0,15" FontSize="15" />

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
             Text="{Binding FormCoverPath, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             materialDesign:HintAssist.Hint="Путь к файлу обложки"
             IsReadOnly="True"/>

                            <Button Grid.Column="1" Content="📁 Обзор..."
            Command="{Binding BrowseCoverCommand}"
            Height="36" Margin="8,0,0,0" Padding="12,0"/>
                        </Grid>

                        <!-- Превью обложки -->
                        <Border Margin="0,0,0,15" Height="180" Background="#f0f0f0"
        BorderBrush="#ddd" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <TextBlock Text="Обложка не выбрана" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="Gray" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormCoverPath}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Image Source="{Binding FormCoverPath, Converter={StaticResource PathToImage}}"
               Stretch="Uniform" MaxHeight="180"/>
                            </Grid>
                        </Border>

                        <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                                 materialDesign:HintAssist.Hint="Аннотация / Описание книги" Margin="0,0,0,15" />

                        <TextBlock Text="Текст книги / Главы:" FontSize="14" Foreground="Gray" Margin="0,5,0,5"/>
                        <TextBox Text="{Binding FormContentText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" 
                                 Height="350" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsTab="True"
                                 materialDesign:HintAssist.Hint="Вставьте или напишите текст произведения сюда..." FontFamily="Consolas" FontSize="14" />

                        <Button Content="Сохранить изменения" Command="{Binding SaveBookCommand}" 
                                Margin="0,20,0,0" Height="45" Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
