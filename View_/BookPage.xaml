<UserControl x:Class="Read_Write_Slowly.View_.BookPge"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#f8f9fa">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <materialDesign:Card UniformCornerRadius="8" Padding="0" Margin="0,0,0,15">
                    <Image Source="{Binding CurrentBook.CoverPath}" Height="450" Stretch="UniformToFill"/>
                </materialDesign:Card>

                <TextBlock Text="{Binding CurrentBook.Title}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding CurrentBook.AuthorName}" FontSize="16" Foreground="#3498db" Margin="0,0,0,15" FontWeight="SemiBold"/>

                <Button Content="Читать книгу" Command="{Binding ReadBookCommand}" Height="45" Margin="0,0,0,15" Style="{StaticResource MaterialDesignRaisedButton}"/>

                <TextBlock Text="Описание:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding CurrentBook.Description}" FontSize="14" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Пожаловаться на книгу" Command="{Binding ComplainBookCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red"/>
                </StackPanel>

                <StackPanel Visibility="{Binding AdminControlsVisibility}" Margin="0,20,0,0">
                    <Separator Background="Red" Margin="0,10"/>
                    <TextBlock Text="Панель администратора" Foreground="Red" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Content="Заморозить книгу" Command="{Binding FreezeBookCommand}" Background="DarkRed" BorderBrush="DarkRed" Foreground="White"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Padding="15" Margin="0,0,0,20" Background="White">
                    <StackPanel>
                        <TextBlock Text="Оставить отзыв" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Ваша оценка: " VerticalAlignment="Center"/>
                            <ComboBox Width="70" Margin="10,0,0,0" SelectedValue="{Binding NewReviewRating}">
                                <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">5</System:Double>
                                <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">4</System:Double>
                                <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">3</System:Double>
                                <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">2</System:Double>
                                <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">1</System:Double>
                            </ComboBox>
                            <materialDesign:PackIcon Kind="Star" Foreground="Gold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox Text="{Binding NewReviewText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                                 materialDesign:HintAssist.Hint="Напишите, что вы думаете о книге..."/>

                        <Button Content="Отправить отзыв" Command="{Binding SubmitReviewCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <ListBox Grid.Row="1" ItemsSource="{Binding Reviews}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,10" Padding="15" Background="White">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="Bold" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                                                <materialDesign:PackIcon Kind="Star" Foreground="Gold" Width="16" Height="16"/>
                                                <TextBlock Text="{Binding Rating}" FontWeight="Bold" Margin="3,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}" Foreground="Gray" FontSize="12"/>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,10,0,10" FontSize="14"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Пожаловаться" 
                                                Command="{Binding DataContext.ComplainReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="Orange" Height="30" FontSize="12"/>

                                        <Button Content="Заморозить отзыв" 
                                                Command="{Binding DataContext.FreezeReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.AdminControlsVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="DarkRed" Height="30" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>