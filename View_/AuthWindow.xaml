<Window x:Class="Read_Write_Slowly.View_.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Read_Write_Slowly.Converters"
        xmlns:viewmodels="clr-namespace:Read_Write_Slowly.ViewModels_"
        Title="Читай, пиши и не спеши... - Авторизация" 
        Height="550" Width="400" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.DataContext>
        <viewmodels.AuthViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:ParamConverter x:Key="ParamConverter"/>
    </Window.Resources>

    <Grid>
        <materialDesign:Card Margin="25" Padding="25" UniformCornerRadius="15" Background="White">
            <StackPanel VerticalAlignment="Center">

                <materialDesign:PackIcon Kind="BookLock" Width="64" Height="64" HorizontalAlignment="Center" Foreground="#673AB7" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding FormHeader}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333" Margin="0,0,0,25"/>

                <TextBox Text="{Binding LoginOrEmail, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Логин или Email" 
                         Margin="0,0,0,15" FontSize="15"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Account" />

                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding RegistrationFieldsVisibility}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Электронная почта" 
                         Margin="0,0,0,15" FontSize="15"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Email" />

                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding RegistrationFieldsVisibility}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Имя (Никнейм) на сайте" 
                         Margin="0,0,0,15" FontSize="15"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="AccountCardDetails" />

                <PasswordBox x:Name="PassBox" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             materialDesign:HintAssist.Hint="Пароль" 
                             Margin="0,0,0,25" FontSize="15"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Lock" />

                <Button Content="{Binding SubmitButtonText}" 
                        Height="45" FontSize="16" FontWeight="Bold"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#673AB7" BorderBrush="#673AB7">
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource ParamConverter}">
                            <Binding ElementName="PassBox"/>
                            <Binding RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Button.CommandParameter>
                    <Button.Command>
                        <Binding Path="SubmitCommand"/>
                    </Button.Command>
                </Button>

                <Button Content="{Binding SwitchModeText}" 
                        Command="{Binding SwitchModeCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#673AB7" Margin="0,15,0,0" Height="35"/>

            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
