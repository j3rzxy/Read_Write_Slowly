<Window x:Class="Read_Write_Slowly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Read_Write_Slowly"
        mc:Ignorable="d"
        Title="Книжный сервис" Height="700" Width="1200" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2c3e50">
            <StackPanel Margin="0,20,0,0">

                <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                        ToolTip="Каталог книг" Margin="0,10" Command="{Binding NavigateCatalogCommand}">
                    <materialDesign:PackIcon Kind="BookOpenOutline" Width="24" Height="24" Foreground="White" />
                </Button>

                <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                        ToolTip="Мои списки" Margin="0,10" Command="{Binding NavigateListsCommand}">
                    <materialDesign:PackIcon Kind="ViewList" Width="24" Height="24" Foreground="White"/>
                </Button>

                <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                        ToolTip="Профиль" Margin="0,10" Command="{Binding NavigateProfileCommand}">
                    <materialDesign:PackIcon Kind="AccountCircleOutline" Width="24" Height="24" Foreground="White"/>
                </Button>

                <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                        ToolTip="Кабинет автора" Margin="0,10" Visibility="{Binding IsAuthorVisible}" Command="{Binding NavigateAuthorCommand}">
                    <materialDesign:PackIcon Kind="Pen" Width="24" Height="24" Foreground="White"/>
                </Button>

                <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                        ToolTip="Администрирование" Margin="0,10" Visibility="{Binding IsAdminVisible}" Command="{Binding NavigateAdminCommand}">
                    <materialDesign:PackIcon Kind="ShieldAccountOutline" Width="24" Height="24" Foreground="White"/>
                </Button>

            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="10" />

    </Grid>
</Window>
